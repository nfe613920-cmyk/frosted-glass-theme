+// Keep native scrolling and drag behavior; paint only the translucent thumb.
+class GlassScrollBar : public QScrollBar
+{
+public:
+    explicit GlassScrollBar(Qt::Orientation orientation, QWidget *parent)
+        : QScrollBar(orientation, parent)
+    {
+        setAttribute(Qt::WA_OpaquePaintEvent, false);
+        setAutoFillBackground(false);
+    }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        if (minimum() == maximum()) return;
+        QStyleOptionSlider option;
+        initStyleOption(&option);
+        const QRect handle = style()->subControlRect(QStyle::CC_ScrollBar, &option, QStyle::SC_ScrollBarSlider, this);
+        QPainter painter(this);
+        // Replace the backing-store region, rather than stacking another glass layer.
+        painter.setCompositionMode(QPainter::CompositionMode_Source);
+        painter.fillRect(rect(), QColor(27, 43, 55, 145));
+        painter.setCompositionMode(QPainter::CompositionMode_SourceOver);
+        painter.setRenderHint(QPainter::Antialiasing);
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(QColor(255, 255, 255, 60));
+        painter.drawRoundedRect(handle, 4, 4);
+    }
+};

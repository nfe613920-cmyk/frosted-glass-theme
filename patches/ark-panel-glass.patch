+void MainWindow::paintEvent(QPaintEvent *event)
+{
+    if (qEnvironmentVariableIsSet("ARK_PANEL_GLASS")) {
+        QPainter painter(this);
+        painter.fillRect(event->rect(), QColor(27, 43, 55, 145));
+    }
+    KParts::MainWindow::paintEvent(event);
+}
+
+void MainWindow::showEvent(QShowEvent *event)
+{
+    KParts::MainWindow::showEvent(event);
+    if (qEnvironmentVariableIsSet("ARK_PANEL_GLASS")) {
+        KWindowEffects::enableBlurBehind(windowHandle(), true);
+        for (auto *area : findChildren<QAbstractScrollArea *>()) {
+            if (!dynamic_cast<GlassScrollBar *>(area->verticalScrollBar()))
+                area->setVerticalScrollBar(new GlassScrollBar(Qt::Vertical, area));
+            if (!dynamic_cast<GlassScrollBar *>(area->horizontalScrollBar()))
+                area->setHorizontalScrollBar(new GlassScrollBar(Qt::Horizontal, area));
+        }
+        for (auto *widget : findChildren<QWidget *>()) {
+            if (qobject_cast<QScrollBar *>(widget) || widget->objectName().startsWith(QStringLiteral("qt_scrollarea_"))) {
+                widget->ensurePolished();
+                widget->setAttribute(Qt::WA_OpaquePaintEvent, false);
+                widget->setAttribute(Qt::WA_StyledBackground, false);
+                widget->setAutoFillBackground(false);
+            }
+        }
+    }
+}

+bool KateMainWindow::eventFilter(QObject *object, QEvent *event)
+{
+    auto *bar = qobject_cast<QScrollBar *>(object);
+    // Editor minimaps keep their own painting and bookmark behavior.
+    if (qEnvironmentVariableIsSet("KATE_PANEL_GLASS") && event->type() == QEvent::Paint
+        && bar && bar->window() == this && !bar->inherits("KateScrollBar")) {
+        QPainter painter(bar);
+        painter.setCompositionMode(QPainter::CompositionMode_Source);
+        painter.fillRect(bar->rect(), QColor(27, 43, 55, 145));
+        painter.setCompositionMode(QPainter::CompositionMode_SourceOver);
+        QStyleOptionSlider option;
+        option.initFrom(bar);
+        option.orientation = bar->orientation();
+        option.minimum = bar->minimum();
+        option.maximum = bar->maximum();
+        option.sliderPosition = bar->sliderPosition();
+        option.sliderValue = bar->value();
+        option.singleStep = bar->singleStep();
+        option.pageStep = bar->pageStep();
+        if (option.minimum != option.maximum) {
+            const QRect handle = bar->style()->subControlRect(QStyle::CC_ScrollBar, &option, QStyle::SC_ScrollBarSlider, bar);
+            painter.setRenderHint(QPainter::Antialiasing);
+            painter.setPen(Qt::NoPen);
+            painter.setBrush(QColor(255, 255, 255, 60));
+            painter.drawRoundedRect(handle, 4, 4);
+        }
+        return true;
+    }
+    return KateMDI::MainWindow::eventFilter(object, event);
+}
+
+void KateMainWindow::paintEvent(QPaintEvent *event)
+{
+    if (qEnvironmentVariableIsSet("KATE_PANEL_GLASS")) {
+        QPainter painter(this);
+        painter.fillRect(event->rect(), QColor(27, 43, 55, 145));
+    }
+    KateMDI::MainWindow::paintEvent(event);
+}
+
+void KateMainWindow::showEvent(QShowEvent *event)
+{
+    KateMDI::MainWindow::showEvent(event);
+    if (qEnvironmentVariableIsSet("KATE_PANEL_GLASS")) KWindowEffects::enableBlurBehind(windowHandle(), true);
+}

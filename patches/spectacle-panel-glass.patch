diff --git a/src/Gui/PanelGlassSpinBox.qml b/src/Gui/PanelGlassSpinBox.qml
new file mode 100644
index 0000000..89a1dd7
--- /dev/null
+++ b/src/Gui/PanelGlassSpinBox.qml
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: MIT
+import QtQuick
+import QtQuick.Templates as T
+import QtQuick.Controls as QQC
+
+T.SpinBox {
+    id: root
+    implicitWidth: implicitContentWidth + leftPadding + rightPadding
+    implicitHeight: implicitContentHeight + topPadding + bottomPadding
+    padding: 4
+    leftPadding: 6
+    rightPadding: 24
+    editable: true
+    wheelEnabled: true
+    hoverEnabled: true
+    validator: IntValidator { bottom: Math.min(root.from, root.to); top: Math.max(root.from, root.to) }
+    background: Rectangle { radius: 4; color: "#0cffffff"; border.color: root.activeFocus ? "#b449b7df" : "#28ffffff" }
+    up.indicator: Rectangle {
+        x: root.width - width; y: 0; implicitWidth: 20; implicitHeight: root.height / 2
+        color: root.up.pressed ? "#3049b7df" : root.up.hovered ? "#1cffffff" : "transparent"
+        QQC.Label { anchors.centerIn: parent; text: "⌃"; color: root.palette.text }
+    }
+    down.indicator: Rectangle {
+        x: root.width - width; y: root.height / 2; implicitWidth: 20; implicitHeight: root.height / 2
+        color: root.down.pressed ? "#3049b7df" : root.down.hovered ? "#1cffffff" : "transparent"
+        QQC.Label { anchors.centerIn: parent; text: "⌄"; color: root.palette.text }
+    }
+    contentItem: QQC.TextField {
+        implicitWidth: metrics.advanceWidth + 6
+        implicitHeight: metrics.height + 2
+        font: root.font
+        color: root.palette.text
+        text: root.displayText
+        background: null
+        padding: 0
+        selectByMouse: true
+        readOnly: !root.editable
+        validator: root.validator
+        verticalAlignment: Text.AlignVCenter
+        TextMetrics { id: metrics; font: root.font; text: root.textFromValue(root.to, root.locale) }
+        onEditingFinished: if (acceptableInput) {
+            root.value = root.valueFromText(text, root.locale)
+            root.valueModified()
+        }
+    }
+}
